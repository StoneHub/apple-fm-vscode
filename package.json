{
  "name": "apple-fm-inline-completion",
  "displayName": "Apple FM Inline Completion",
  "description": "Inline suggestions powered by the Apple model on your Mac.",
  "version": "0.1.8",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StoneHub/apple-fm-vscode.git"
  },
  "homepage": "https://github.com/StoneHub/apple-fm-vscode#readme",
  "bugs": {
    "url": "https://github.com/StoneHub/apple-fm-vscode/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "appleFm.requestSuggestion",
        "title": "Apple FM: Request Suggestion"
      },
      {
        "command": "appleFm.enable",
        "title": "Apple FM: Enable"
      },
      {
        "command": "appleFm.disable",
        "title": "Apple FM: Disable"
      },
      {
        "command": "appleFm.showMenu",
        "title": "Apple FM: Open Control Panel"
      },
      {
        "command": "appleFm.refactorSelection",
        "title": "Apple FM: Refactor Selection"
      },
      {
        "command": "appleFm.refactor.generate",
        "title": "Generate 3",
        "icon": "$(sparkle)",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "appleFm.refactor.previous",
        "title": "Previous alternative",
        "icon": "$(chevron-left)"
      },
      {
        "command": "appleFm.refactor.next",
        "title": "Next alternative",
        "icon": "$(chevron-right)"
      },
      {
        "command": "appleFm.refactor.more",
        "title": "Generate 3 more",
        "icon": "$(add)"
      },
      {
        "command": "appleFm.refactor.toggleChanges",
        "title": "Toggle changes / replacement",
        "icon": "$(diff)"
      },
      {
        "command": "appleFm.refactor.apply",
        "title": "Apply",
        "icon": "$(check)"
      },
      {
        "command": "appleFm.refactor.stop",
        "title": "Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "appleFm.refactor.close",
        "title": "Close",
        "icon": "$(close)"
      }
    ],
    "configuration": {
      "title": "Apple FM",
      "properties": {
        "appleFm.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Apple FM inline suggestions."
        },
        "appleFm.backend": {
          "type": "string",
          "enum": [
            "fm",
            "swift"
          ],
          "default": "fm",
          "description": "Explicit on-device backend."
        },
        "appleFm.contextScope": {
          "type": "string",
          "enum": [
            "nearby",
            "currentFile"
          ],
          "default": "nearby",
          "description": "Source context sent to the selected backend."
        },
        "appleFm.swiftHelperPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional absolute path to apple-fm-helper."
        },
        "appleFm.automaticSuggestions": {
          "type": "boolean",
          "default": true,
          "description": "Request suggestions while typing. Explicit requests remain available when this is off."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "appleFm",
          "title": "Apple FM",
          "icon": "media/applefm.svg"
        }
      ]
    },
    "views": {
      "appleFm": [
        {
          "id": "appleFm.statusView",
          "name": "Apple FM",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "appleFm.refactorSelection",
          "when": "editorHasSelection",
          "group": "1_modification"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "appleFm.refactor.generate",
          "group": "inline",
          "when": "commentController == apple-fm-refactor && (commentThread == appleFmReady || commentThread == appleFmResults)"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "appleFm.refactor.previous",
          "group": "navigation@0",
          "when": "commentController == apple-fm-refactor && (commentThread == appleFmResults || commentThread == appleFmBusy)"
        },
        {
          "command": "appleFm.refactor.next",
          "group": "navigation@1",
          "when": "commentController == apple-fm-refactor && (commentThread == appleFmResults || commentThread == appleFmBusy)"
        },
        {
          "command": "appleFm.refactor.toggleChanges",
          "group": "navigation@2",
          "when": "commentController == apple-fm-refactor && (commentThread == appleFmResults || commentThread == appleFmBusy)"
        },
        {
          "command": "appleFm.refactor.more",
          "group": "navigation@3",
          "when": "commentController == apple-fm-refactor && commentThread == appleFmResults"
        },
        {
          "command": "appleFm.refactor.apply",
          "group": "navigation@4",
          "when": "commentController == apple-fm-refactor && commentThread == appleFmResults"
        },
        {
          "command": "appleFm.refactor.stop",
          "group": "navigation@5",
          "when": "commentController == apple-fm-refactor && commentThread == appleFmBusy"
        },
        {
          "command": "appleFm.refactor.close",
          "group": "navigation@6",
          "when": "commentController == apple-fm-refactor"
        }
      ],
      "commandPalette": [
        {
          "command": "appleFm.refactor.generate",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.previous",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.next",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.more",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.toggleChanges",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.apply",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.stop",
          "when": "false"
        },
        {
          "command": "appleFm.refactor.close",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && for f in scripts/regression-*.js; do node \"$f\" || exit 1; done",
    "copy-swift-helper": "./scripts/copy-swift-helper.sh",
    "package": "npm test && npm run copy-swift-helper && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
